# Supabase project URL and publishable key. These are public in the browser.
# Row Level Security is what keeps each account private.
# Prefer the sb_publishable_ key. The older JWT anon key still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Used in password-reset links if the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave AI_PROVIDER as local, or unset, to use the built-in template generator.
# Set openai or gemini, plus a key, only when you want a connected model.
# Gemini tries AI_MODEL first, then gemini-3.8-flash, gemini-3.6-flash, and Flash Lite models if one is busy or missing.
AI_PROVIDER=local
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Sign-in email for the skill shop admin desk. Must also be inserted into app_admins in Supabase.
MARKETPLACE_ADMIN_EMAIL=
